{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vindigit.github.io/TheArena/assets/manifest.schema.json",
  "title": "TheArena accepted runtime assets",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "assets"],
  "properties": {
    "version": { "const": 1 },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/definitions/asset" }
    }
  },
  "definitions": {
    "nullableText": { "type": ["string", "null"] },
    "check": { "enum": ["pass", "fail", "pending", "not-applicable"] },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "status", "source", "license", "runtime", "validation", "integration"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "category": { "enum": ["model", "animation", "texture", "audio"] },
        "status": { "enum": ["accepted", "preview"] },
        "source": { "$ref": "#/definitions/source" },
        "license": { "$ref": "#/definitions/license" },
        "runtime": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/runtimeFile" }
        },
        "validation": { "$ref": "#/definitions/validation" },
        "integration": { "$ref": "#/definitions/integration" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "prompt", "modelId", "modelVersion", "settings", "seed", "scenarioAssetId", "scenarioJobId", "generatedAt"],
      "properties": {
        "type": { "enum": ["scenario", "local", "third-party"] },
        "prompt": { "$ref": "#/definitions/nullableText" },
        "negativePrompt": { "$ref": "#/definitions/nullableText" },
        "modelId": { "$ref": "#/definitions/nullableText" },
        "modelVersion": { "$ref": "#/definitions/nullableText" },
        "settings": { "type": ["object", "null"] },
        "seed": { "type": ["integer", "null"] },
        "referenceAssetIds": { "type": "array", "items": { "type": "string" } },
        "scenarioAssetId": { "$ref": "#/definitions/nullableText" },
        "scenarioJobId": { "$ref": "#/definitions/nullableText" },
        "generatedAt": { "$ref": "#/definitions/nullableText" },
        "optimizationSteps": { "type": "array", "items": { "type": "string" } },
        "outputNotes": { "type": "string" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "commercialUse", "attribution", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": ["string", "null"] },
        "commercialUse": { "type": ["boolean", "null"], "description": "True or false when documented; null when the supplied provenance establishes no commercial-use license." },
        "attribution": { "$ref": "#/definitions/nullableText" },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "tiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxMeanRgbError"],
      "properties": {
        "maxMeanRgbError": { "type": "number", "minimum": 0, "maximum": 255 },
        "maxPeakRgbError": { "type": "number", "minimum": 0, "maximum": 255 }
      }
    },
    "runtimeFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^assets/(models|animations|textures|audio)/[a-z0-9/_-]+\\.(glb|webp|png|ktx2|mp3|ogg)$" },
        "format": { "enum": ["glb", "webp", "png", "ktx2", "mp3", "ogg"] },
        "bytes": { "type": "integer", "minimum": 1 },
        "maxBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "dimensions": { "$ref": "#/definitions/dimensions" },
        "tiling": { "$ref": "#/definitions/tiling" },
        "triangles": { "type": "integer", "minimum": 0 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "measured", "notes"],
      "properties": {
        "checks": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/check" }
        },
        "measured": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "number" },
              { "type": "boolean" },
              { "type": "string" },
              { "type": "null" }
            ]
          }
        },
        "notes": { "type": "string" }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "fallback"],
      "properties": {
        "module": { "type": "string", "pattern": "^src/[a-z0-9/_-]+\\.js$" },
        "fallback": { "type": "string", "minLength": 1 }
      }
    }
  }
}
