{
  "version": 2,
  "id": "game-humanoid-v2",
  "status": "staged-not-production",
  "selection": {
    "productionDefault": "legacy-luke-v1",
    "stagedOptIn": "createPlayer option rigContract=game-humanoid-v2",
    "legacyRetainedUntil": "both v2 player GLBs exist and pass validation"
  },
  "limits": {
    "maxBytes": 1500000,
    "maxTriangles": 8000,
    "heightMeters": [1.9, 2.2],
    "meshes": 1,
    "skins": 1
  },
  "boneNameNormalization": {
    "acceptedSourcePrefix": "mixamorig:",
    "runtimePrefix": null,
    "mixamoAssetUseImplied": false
  },
  "requiredBones": [
    "Hips", "Spine", "Spine1", "Spine2", "Neck", "Head",
    "LeftShoulder", "LeftArm", "LeftForeArm", "LeftHand",
    "RightShoulder", "RightArm", "RightForeArm", "RightHand",
    "LeftUpLeg", "LeftLeg", "LeftFoot", "LeftToeBase",
    "RightUpLeg", "RightLeg", "RightFoot", "RightToeBase"
  ],
  "explicitArticulationChecks": {
    "spine": ["Spine", "Spine1", "Spine2"],
    "shoulders": ["LeftShoulder", "RightShoulder"],
    "toes": ["LeftToeBase", "RightToeBase"]
  },
  "notImplementedInStep1": [
    "v2 Blender armatures and weights",
    "fictional-player-v2.glb",
    "luke-player-preview.glb",
    "runtime v2 pose adapter and ball sockets",
    "visible FALLBACK PLAYER badge",
    "CI fallback detection for both v2 GLBs",
    "animation library, clip events, and mixer crossfades"
  ]
}
